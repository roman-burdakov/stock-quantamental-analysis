# FRED API — Get a key at: https://fredaccount.stlouisfed.org/ → Request API Key
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR requires a valid User-Agent with your app name and contact email
# See: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=NVDAQuantamentalEngine your-email@example.com
